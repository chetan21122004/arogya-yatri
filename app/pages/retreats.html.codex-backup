  <script>
    function closeConsultantModal() { document.getElementById("consultantModal").classList.add("hidden"); }
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.openConsultantModal').forEach(btn => {
        btn.addEventListener('click', e => { e.preventDefault(); const m = document.getElementById('consultantModal'); m.classList.remove('hidden'); m.classList.add('flex'); });
      });
      document.getElementById('consultantModal').addEventListener('click', e => { if (e.target === document.getElementById('consultantModal')) closeConsultantModal(); });
      document.getElementById('menuBtn').onclick = () => document.getElementById('mobileMenu').classList.remove('-translate-x-full');
      document.getElementById('closeBtn').onclick = () => document.getElementById('mobileMenu').classList.add('-translate-x-full');
      const eb = document.getElementById('mobileExploreBtn');
      if (eb) { eb.addEventListener('click', () => { document.getElementById('mobileExploreMenu').classList.toggle('hidden'); document.getElementById('mobileExploreIcon').classList.toggle('bx-chevron-down'); document.getElementById('mobileExploreIcon').classList.toggle('bx-chevron-up'); }); }
    });
  </script>
  <script src="../script/scroll-animations.js"></script>
